{
  "name": "@mccopilot/mobile",
  "version": "1.0.0",
  "private": true,
  "main": "index.tsx",
  "scripts": {
    "start": "react-native webpack-start",
    "ios": "react-native run-ios",
    "bundle-ios": "react-native webpack-bundle --entry-file index.tsx --platform ios --dev false --bundle-output ../../../MCCopilot/main.jsbundle --assets-dest ../../../MCCopilot",
    "bundle-ios-dev": "react-native webpack-bundle --entry-file index.tsx --platform ios --dev true --bundle-output ../../../MCCopilot/main.jsbundle --assets-dest ../../../MCCopilot",
    "type-check": "tsc --noEmit",
    "lint": "eslint . --ext .ts,.tsx"
  },
  "dependencies": {
    "@mccopilot/app-example": "*",
    "@mccopilot/app-second": "*",
    "react": "19.2.3",
    "react-native": "0.85.3",
    "react-native-mccopilot": "*",
    "react-native-nitro-modules": "^0.35.7"
  }
}
