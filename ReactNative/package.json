{
  "name": "@mccopilot/react-native-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "MCCopilot React Native workspace root",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "start": "npm run start -w @mccopilot/mobile",
    "bundle-ios": "npm run bundle-ios -w @mccopilot/mobile",
    "bundle-ios-dev": "npm run bundle-ios-dev -w @mccopilot/mobile",
    "type-check": "npm run type-check -ws",
    "lint": "npm run lint -ws",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md}\""
  },
  "dependencies": {
    "react": "19.2.3",
    "react-native": "0.85.3",
    "react-native-nitro-modules": "^0.35.7",
    "react-native-safe-area-context": "^5.8.0"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/preset-env": "^7.25.3",
    "@babel/runtime": "^7.25.0",
    "@callstack/repack": "^5.2.5",
    "@react-native-community/cli": "20.1.0",
    "@react-native-community/cli-platform-ios": "20.1.0",
    "@react-native/babel-preset": "0.85.3",
    "@react-native/eslint-config": "0.85.3",
    "@react-native/metro-config": "0.85.3",
    "@react-native/typescript-config": "0.85.3",
    "@rspack/core": "^1.3.4",
    "@swc/helpers": "^0.5.17",
    "@types/react": "^19.2.0",
    "eslint": "^8.19.0",
    "prettier": "^3.0.0",
    "typescript": "^5.8.3"
  },
  "engines": {
    "node": ">=22.11.0"
  }
}
